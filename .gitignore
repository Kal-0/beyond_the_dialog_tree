# ===========================
# Ren'Py Engine & Runtime
# ===========================
# The Ren'Py SDK ships these; they should NOT be in the game repo.
renpy/
lib/

# ===========================
# Ren'Py Compiled / Generated
# ===========================
# .rpyc = compiled Ren'Py script (auto-regenerated from .rpy)
# .rpyb = bytecode cache
*.rpyc
*.rpyb
game/cache/

# ===========================
# Ren'Py Runtime Data
# ===========================
game/saves/
*.bak

# ===========================
# Ren'Py Launcher Metadata
# ===========================
project.json

# ===========================
# LLM Debug Logs
# ===========================
llm_debug_log.txt

# ===========================
# Python
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.so

# ===========================
# Virtual Environments
# ===========================
.venv/
venv/
env/

# ===========================
# IDE / Editor
# ===========================
.vscode/
.idea/

# ===========================
# OS Generated
# ===========================
Thumbs.db
Desktop.ini
.DS_Store

# ===========================
# Project-specific temp files
# ===========================
test_*
errors.txt
traceback.txt
log.txt